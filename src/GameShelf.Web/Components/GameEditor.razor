<div class="modal-head">
    <div><span class="eyebrow">YOUR COLLECTION</span><h2 id="editor-title">@(Existing is null ? "Add a game" : "Edit game")</h2></div>
    <button type="button" class="icon-button" aria-label="Close editor" @onclick="OnCancel">✕</button>
</div>
<form class="game-form" @onsubmit="Submit" @onsubmit:preventDefault>
    @if (Error is not null) { <div class="alert" role="alert">@Error</div> }
    <div class="form-grid">
        <label class="field field-wide">Game title <span>*</span>
            <input type="text" maxlength="120" required placeholder="e.g. Hollow Knight" @bind="_title" />
        </label>
        <label class="field">Platform <span>*</span>
            <input type="text" maxlength="60" required placeholder="e.g. PC" @bind="_platform" />
        </label>
        <label class="field">Genre <span>*</span>
            <input type="text" maxlength="60" required placeholder="e.g. Adventure" @bind="_genre" />
        </label>
        <label class="field">Play status
            <select @bind="_status">
                @foreach (var status in Enum.GetValues<PlayStatus>())
                { <option value="@status">@status.Label()</option> }
            </select>
        </label>
        <label class="field">Score <small>(optional)</small>
            <input type="number" min="1" max="10" step="1" placeholder="1–10" @bind="_score" />
        </label>
        <label class="field field-wide">Hours played
            <input type="number" min="0" max="100000" step="0.1" @bind="_hours" />
        </label>
        <label class="field field-wide">Your notes
            <textarea rows="4" maxlength="2000" placeholder="What stood out about this game?" @bind="_notes"></textarea>
        </label>
        <label class="check-field"><input type="checkbox" @bind="_favorite" /> <span>Mark as a favorite</span></label>
    </div>
    <div class="modal-actions">
        <button type="button" class="button button-ghost" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="button button-primary">@(Existing is null ? "Add to library" : "Save changes")</button>
    </div>
</form>

@code {
    [Parameter] public GameEntry? Existing { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<GameDraft> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _title = "";
    private string _platform = "PC";
    private string _genre = "";
    private PlayStatus _status = PlayStatus.WantToPlay;
    private int? _score;
    private decimal _hours;
    private string _notes = "";
    private bool _favorite;

    protected override void OnInitialized()
    {
        if (Existing is null) return;
        _title = Existing.Title;
        _platform = Existing.Platform;
        _genre = Existing.Genre;
        _status = Existing.Status;
        _score = Existing.Score;
        _hours = Existing.HoursPlayed;
        _notes = Existing.Notes;
        _favorite = Existing.Favorite;
    }

    private Task Submit() => OnSave.InvokeAsync(new GameDraft(
        _title, _platform, _genre, _status, _score, _hours, _notes, _favorite));
}
